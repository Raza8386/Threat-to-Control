# Copy to .env and fill in. Never commit .env.

# Claude API key from console.anthropic.com (needed from Phase 2)
ANTHROPIC_API_KEY=

# Embeddings: nano = local voyage-4-nano (free), voyage = hosted Voyage API
EMBED_BACKEND=nano
EMBED_DIM=1024
# Slow CPU? Use the small local model instead (rebuild the index after switching):
# EMBED_BACKEND=local
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# VOYAGE_API_KEY=          # only for EMBED_BACKEND=voyage
# VOYAGE_API_MODEL=voyage-4-lite

# Models
ANSWER_MODEL=claude-sonnet-5-5
GUARDRAIL_MODEL=claude-haiku-5-5

# Security (production on Render)
# APP_ENV=production
# TRUST_PROXY=1
# ALLOWED_ORIGINS=https://your-app.vercel.app
RATE_LIMIT_PER_MIN=8
RATE_LIMIT_PER_DAY=60
DAILY_COST_CAP_USD=2.00
REQUEST_COST_RESERVE_USD=0.02
# EMBED_MODEL_REVISION=<commit hash of voyageai/voyage-4-nano>
